# Copy to .env.illustrations when a service is available. Existing shell values win.
# Base URLs stay blank until the corresponding backend is installed or provided.
PAPER2ANY_URL=
PAPER2ANY_API_KEY=
# Override if your deployment uses a different header.
PAPER2ANY_API_KEY_HEADER=X-API-Key

# Self-hosted ComfyUI API, e.g. http://127.0.0.1:8188
COMFYUI_URL=
COMFYUI_API_KEY=
COMFYUI_API_KEY_HEADER=Authorization
